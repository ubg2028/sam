---
// src/components/Footer.astro
// Every important page on the site is linked from here so nothing is
// orphaned — a requirement AdSense reviewers check for.
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo"><span class="logo-mark">🌿</span>Verdant Notes</a>
        <p>Clear, well-researched essays on technology, work, and sustainable living — written by people who've done the thing.</p>
        <div class="social-row">
          <a href="#" aria-label="Verdant Notes on X">X</a>
          <a href="#" aria-label="Verdant Notes on LinkedIn">in</a>
          <a href="/rss.xml" aria-label="Verdant Notes RSS feed">RSS</a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/team">Editorial Team</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/team">Our Writers</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/gdpr">GDPR</a></li>
          <li><a href="/dmca">DMCA</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Verdant Notes. All rights reserved.</p>
    <nav aria-label="Legal">
      <ul>
        <li><a href="/privacy-policy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/disclaimer">Disclaimer</a></li>
        <li><a href="/gdpr">GDPR</a></li>
        <li><a href="/dmca">DMCA</a></li>
      </ul>
    </nav>
  </div>
</footer>
