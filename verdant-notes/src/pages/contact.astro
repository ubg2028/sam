---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<BaseLayout
  title="Contact"
  description="Get in touch with the Verdant Notes team — story tips, corrections, advertising inquiries, or general questions."
  currentPath="/contact"
>
  <div class="container">
    <Breadcrumb items={[{ label: 'Contact' }]} />

    <div style="padding:var(--space-4) 0 var(--space-5);">
      <div class="form-page">
        <h1>Get in touch</h1>
        <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4);">
          Whether it's a story tip, a correction, or an advertising inquiry, we read every message and typically reply within two business days.
        </p>

        <!--
          This form posts nowhere by default (static site, zero JS by design).
          Point the `action` attribute at a form backend of your choice
          (Formspree, Getform, a serverless function, etc.) to make it functional.
        -->
        <form class="contact-form" aria-label="Contact form" method="POST" action="#">
          <div class="field">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <select id="subject" name="subject">
              <option>General question</option>
              <option>Story tip</option>
              <option>Correction request</option>
              <option>Advertising inquiry</option>
              <option>DMCA takedown request</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" required></textarea>
            <p class="field-hint">Please don't include sensitive personal information in this form.</p>
          </div>
          <button type="submit" class="btn-primary">Send message</button>
        </form>

        <div class="contact-info" id="newsletter">
          <h2 style="font-size:1.2rem;">Business details</h2>
          <dl>
            <dt>Publisher</dt>
            <dd>Verdant Notes Media</dd>
            <dt>General inquiries</dt>
            <dd><a href="mailto:hello@example.com">hello@example.com</a></dd>
            <dt>Advertising</dt>
            <dd><a href="mailto:ads@example.com">ads@example.com</a></dd>
            <dt>DMCA / copyright</dt>
            <dd><a href="mailto:dmca@example.com">dmca@example.com</a> — see our <a href="/dmca">DMCA policy</a></dd>
            <dt>Mailing address</dt>
            <dd>221 Willow Street, Suite 4B, Portland, OR 97201, United States</dd>
            <dt>Response time</dt>
            <dd>1–2 business days</dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
