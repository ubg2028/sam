---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { getAuthorBySlug } from '../data/authors';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, authorSlug, category, tags, image, imageAlt } = post.data;
const author = getAuthorBySlug(authorSlug);

// Reading time calculation
const wordsPerMinute = 200;
const wordCount = post.body ? post.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / wordsPerMinute));

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Fetch all published posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 1. Calculate dynamic category counts
const categoryMap = allPosts.reduce((acc, p) => {
  const cat = p.data.category;
  if (cat) {
    acc[cat] = (acc[cat] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

const categoryList = Object.entries(categoryMap).map(([name, count]) => ({
  name,
  count,
}));

// 2. "You May Also Like" - Random 3 other posts
const otherPosts = allPosts.filter((p) => p.slug !== post.slug);
const randomPosts = [...otherPosts]
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

// 3. Related Posts for bottom section
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  currentPath={`/sam/blog/${post.slug}`}
  type="article"
  publishedTime={pubDate}
  author={author?.name}
  image={image}
>
  <slot name="head" slot="head" />

  <!-- Smooth Green Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <div class="blog-wrapper">
    <div class="container">
      
      <!-- Compact Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <Breadcrumb items={[{ label: 'Blog', href: '/sam/blog' }, { label: category, href: `/sam/blog?category=${encodeURIComponent(category)}` }, { label: title }]} />
      </nav>

      <!-- Main Layout Grid -->
      <div class="page-layout">
        
        <!-- Main Article Column -->
        <main class="content-col">
          <article class="article-wrapper">
            
            <!-- Article Header -->
            <header class="article-header">
              <div class="header-pills">
                <a href={`/sam/blog?category=${encodeURIComponent(category)}`} class="category-badge">
                  {category}
                </a>
                <span class="read-time-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {readingTime} min read
                </span>
                <span class="date-pill">
                  <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
                </span>
              </div>

              <!-- Article Title -->
              <h1 class="article-title">{title}</h1>

              {description && <p class="article-subtitle">{description}</p>}

              <!-- Quick Meta & Share Strip -->
              <div class="article-meta-card">
                <div class="author-meta-info">
                  <div class="author-avatar-placeholder">
                    {author?.name ? author.name.charAt(0) : 'E'}
                  </div>
                  <div class="meta-details">
                    <span class="author-name">
                      {author ? <a href={`/sam/team/${author.slug}`}>{author.name}</a> : 'Editorial Team'}
                    </span>
                    <div class="date-info">
                      <span>{dateFormatter.format(pubDate)}</span>
                      {updatedDate && (
                        <>
                          <span class="dot">&bull;</span>
                          <span class="updated-text">Updated {dateFormatter.format(updatedDate)}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Quick Share Buttons -->
                <div class="quick-share">
                  <button class="share-btn copy-btn" id="copyLinkBtn" title="Copy article link" aria-label="Copy Link">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span class="tooltip" id="copyTooltip">Link Copied!</span>
                  </button>
                  <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="share-btn" aria-label="Share on X" target="_blank" rel="noopener noreferrer">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="share-btn" aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74V10.13H5.06v8.37h2.8z"/></svg>
                  </a>
                </div>
              </div>
            </header>

            <!-- Featured Image -->
            {image && (
              <figure class="featured-media-box">
                <img src={image} alt={imageAlt ?? title} width="960" height="500" loading="eager" decoding="async" />
                {imageAlt && <figcaption>{imageAlt}</figcaption>}
              </figure>
            )}

            <!-- Post Body Slot -->
            <div class="article-body">
              <slot />
            </div>

            <!-- Tags Section -->
            {tags && tags.length > 0 && (
              <div class="tags-container">
                <span class="tags-label">Related Topics:</span>
                <div class="tags-list">
                  {tags.map((tag: string) => (
                    <a href={`/sam/blog?tag=${encodeURIComponent(tag)}`} class="tag-pill">
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Engagement & Share Box -->
            <div class="share-box">
              <div class="share-box-content">
                <h4>Found this guide valuable?</h4>
                <p>Share it with your teammates and network to help them level up.</p>
              </div>
              <div class="share-box-actions">
                <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="share-pill share-green" target="_blank" rel="noopener noreferrer">
                  Share on X
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="share-pill share-outline" target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
              </div>
            </div>

            <!-- Author Card at Bottom -->
            {author && (
              <div class="author-section">
                <AuthorBio authorSlug={author.slug} />
              </div>
            )}
          </article>

          <!-- Recommended Posts -->
          {relatedPosts.length > 0 && (
            <section class="related-posts" aria-label="Related posts">
              <div class="section-header">
                <h2>Recommended Articles</h2>
                <a href={`/sam/blog?category=${encodeURIComponent(category)}`} class="view-all-link">
                  See all {category} &rarr;
                </a>
              </div>
              <div class="post-grid">
                {relatedPosts.map((related) => (
                  <article class="modern-card">
                    {related.data.image && (
                      <a href={`/sam/blog/${related.slug}`} class="card-thumb" tabindex="-1">
                        <img src={related.data.image} alt={related.data.title} loading="lazy" width="340" height="180" />
                      </a>
                    )}
                    <div class="card-body">
                      <span class="card-category">{related.data.category}</span>
                      <h3 class="card-title">
                        <a href={`/sam/blog/${related.slug}`}>{related.data.title}</a>
                      </h3>
                      <span class="card-date">{dateFormatter.format(related.data.pubDate)}</span>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </main>

        <!-- STICKY SIDEBAR -->
        <aside class="sidebar-col" aria-label="Article Sidebar">
          <div class="sticky-sidebar">
            
            <!-- 1. KEY INSIGHTS (TOC with Smooth Scroll) -->
            <div class="sidebar-widget key-insights-widget" id="toc-widget">
              <div class="widget-header">
                <span class="widget-icon">🎯</span>
                <h3 class="widget-title">Key Insights</h3>
              </div>
              <nav id="toc-list" class="toc-nav" aria-label="Table of contents">
                <!-- Headings dynamically injected by JS -->
              </nav>
            </div>

            <!-- 2. CATEGORIES WITH COUNTS -->
            <div class="sidebar-widget">
              <div class="widget-header">
                <span class="widget-icon">📂</span>
                <h3 class="widget-title">Categories</h3>
              </div>
              <ul class="clean-category-list">
                {categoryList.map((cat) => (
                  <li>
                    <a href={`/sam/blog?category=${encodeURIComponent(cat.name)}`}>
                      <span class="cat-name">{cat.name}</span>
                      <span class="cat-count">{cat.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 3. YOU MAY ALSO LIKE (Random Post Suggestions) -->
            {randomPosts.length > 0 && (
              <div class="sidebar-widget you-may-like-widget">
                <div class="widget-header">
                  <span class="widget-icon">✨</span>
                  <h3 class="widget-title">You May Also Like</h3>
                </div>
                <div class="mini-post-list">
                  {randomPosts.map((randPost) => (
                    <a href={`/sam/blog/${randPost.slug}`} class="mini-post-card">
                      {randPost.data.image && (
                        <div class="mini-post-thumb">
                          <img src={randPost.data.image} alt={randPost.data.title} loading="lazy" />
                        </div>
                      )}
                      <div class="mini-post-content">
                        <span class="mini-post-category">{randPost.data.category}</span>
                        <h4 class="mini-post-title">{randPost.data.title}</h4>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

          </div>
        </aside>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // 1. Reading Progress Bar
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.article-body');
    if (progressBar && article) {
      const totalHeight = article.clientHeight;
      const windowHeight = window.innerHeight;
      const articleOffsetTop = article.getBoundingClientRect().top + window.scrollY;
      const currentScroll = window.scrollY - articleOffsetTop;

      if (currentScroll > 0) {
        const progress = Math.min(100, Math.max(0, (currentScroll / (totalHeight - windowHeight + 100)) * 100));
        progressBar.style.width = `${progress}%`;
      } else {
        progressBar.style.width = '0%';
      }
    }
  });

  // 2. Quick Copy URL Link
  const copyBtn = document.getElementById('copyLinkBtn');
  const tooltip = document.getElementById('copyTooltip');
  if (copyBtn && tooltip) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        tooltip.classList.add('visible');
        setTimeout(() => tooltip.classList.remove('visible'), 2000);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }

  // 3. Key Insights TOC Builder & Smooth Scroll Spy
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('.article-body');
    const tocWidget = document.getElementById('toc-widget');
    const tocList = document.getElementById('toc-list');

    if (!article || !tocWidget || !tocList) return;

    const headings = article.querySelectorAll('h2, h3');

    if (headings.length === 0) {
      tocWidget.style.display = 'none';
      return;
    }

    headings.forEach((heading, index) => {
      let id = heading.id;
      if (!id) {
        id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `section-${index}`;
        heading.id = id;
      }

      const link = document.createElement('a');
      link.href = `#${id}`;
      link.textContent = heading.textContent;
      link.className = heading.tagName.toLowerCase() === 'h3' ? 'toc-link toc-subheading' : 'toc-link toc-heading';

      // Smooth scroll on click
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(id);
        if (target) {
          const headerOffset = 80;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.scrollY - headerOffset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
          history.pushState(null, '', `#${id}`);
        }
      });

      tocList.appendChild(link);
    });

    // ScrollSpy active highlight
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          document.querySelectorAll('.toc-link').forEach((item) => {
            item.classList.toggle('active', item.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '0px 0px -75% 0px' });

    headings.forEach((h) => observer.observe(h));
  });
</script>

<style>
  :root {
    --green-primary: #059669;
    --green-primary-hover: #047857;
    --green-accent: #10b981;
    --green-light: #f0fdf4;
    --green-light-border: #bbf7d0;
    --green-dark: #064e3b;
    --text-heading: #0f172a;
    --text-body: #334155;
    --text-muted: #64748b;
    --bg-surface: #ffffff;
    --bg-subtle: #f8fafc;
    --border-color: #e2e8f0;
    --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.03);
  }

  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3.5px;
    background: linear-gradient(90deg, #34d399, #059669, #047857);
    width: 0%;
    z-index: 9999;
    transition: width 0.05s ease-out;
  }

  .blog-wrapper {
    background-color: var(--bg-surface);
    color: var(--text-body);
    padding: 0.75rem 0 2.5rem;
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .breadcrumb-nav {
    margin-bottom: 0.85rem;
    font-size: 0.82rem;
  }

  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 2rem;
    align-items: start;
  }

  /* ==========================================================
     STICKY SIDEBAR IMPLEMENTATION
  ========================================================== */
  .sidebar-col {
    position: relative;
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--green-light-border) transparent;
  }

  .sidebar-widget {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.1rem;
    box-shadow: var(--card-shadow);
  }

  .widget-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-color);
  }

  .widget-icon {
    font-size: 1rem;
  }

  .widget-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  /* 1. Key Insights (TOC) */
  .key-insights-widget {
    border-top: 3px solid var(--green-primary);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 260px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  :global(.toc-link) {
    font-size: 0.82rem;
    color: #475569;
    text-decoration: none;
    line-height: 1.35;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
  }

  :global(.toc-link:hover) {
    background: var(--green-light);
    color: var(--green-primary);
  }

  :global(.toc-link.active) {
    background: var(--green-light);
    color: var(--green-dark);
    font-weight: 700;
    border-left-color: var(--green-primary);
  }

  :global(.toc-heading) {
    font-weight: 600;
  }

  :global(.toc-subheading) {
    padding-left: 1.15rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* 2. Categories with Counts */
  .clean-category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .clean-category-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    color: var(--text-body);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .clean-category-list a:hover {
    background: var(--green-light);
    color: var(--green-primary);
    padding-left: 0.75rem;
  }

  .cat-count {
    background: var(--green-light);
    color: var(--green-primary);
    border: 1px solid var(--green-light-border);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 12px;
  }

  /* 3. You May Also Like Mini Cards */
  .mini-post-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mini-post-card {
    display: flex;
    gap: 0.65rem;
    text-decoration: none;
    align-items: center;
    padding: 0.35rem;
    border-radius: 6px;
    transition: background 0.15s ease;
  }

  .mini-post-card:hover {
    background: var(--bg-subtle);
  }

  .mini-post-thumb {
    width: 55px;
    height: 55px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f1f5f9;
  }

  .mini-post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mini-post-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    overflow: hidden;
  }

  .mini-post-category {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--green-primary);
    text-transform: uppercase;
  }

  .mini-post-title {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--text-heading);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .mini-post-card:hover .mini-post-title {
    color: var(--green-primary);
  }

  /* ==========================================================
     ARTICLE STYLING & HEADER
  ========================================================== */
  .article-header {
    margin-bottom: 1.25rem;
  }

  .header-pills {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .category-badge {
    background: var(--green-light);
    color: var(--green-primary);
    border: 1px solid var(--green-light-border);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.6rem;
    border-radius: 16px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .category-badge:hover {
    background: #dcfce7;
  }

  .read-time-pill,
  .date-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-title {
    font-size: clamp(1.8rem, 3.2vw, 2.45rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.022em;
    color: var(--text-heading);
    margin: 0 0 0.6rem 0;
  }

  .article-subtitle {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0 0 0.9rem 0;
  }

  .article-meta-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .author-meta-info {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .author-avatar-placeholder {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--green-primary), #047857);
    color: #ffffff;
    font-weight: 700;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }

  .meta-details {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .author-name a,
  .author-name {
    font-weight: 700;
    color: var(--text-heading);
    text-decoration: none;
    font-size: 0.88rem;
  }

  .author-name a:hover {
    color: var(--green-primary);
  }

  .date-info {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .date-info .dot {
    margin: 0 0.2rem;
  }

  .quick-share {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .share-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    cursor: pointer;
    text-decoration: none;
    position: relative;
