---
// src/layouts/PostLayout.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getAuthorBySlug } from '../data/authors';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, authorSlug, category, tags, image, imageAlt } = post.data;
const author = getAuthorBySlug(authorSlug);

// Reading time calculation
const wordsPerMinute = 200;
const wordCount = post.body ? post.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / wordsPerMinute));

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Related Posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  currentPath={`/sam/blog/${post.slug}`}
  type="article"
  publishedTime={pubDate}
  author={author?.name}
  image={image}
>
  <slot name="head" slot="head" />

  <!-- Top Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-bar"></div>

  <div class="blog-wrapper">
    <div class="container">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb-container" aria-label="Breadcrumb">
        <Breadcrumb items={[{ label: 'Blog', href: '/sam/blog' }, { label: category, href: `/sam/blog?category=${encodeURIComponent(category)}` }, { label: title }]} />
      </nav>

      <div class="page-layout">
        <!-- Main Article Column -->
        <main class="content-col">
          <article class="article-wrapper">
            <!-- Article Header -->
            <header class="article-header">
              <div class="header-badges">
                <span class="category-badge">{category}</span>
                <span class="read-time-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {readingTime} min read
                </span>
                <span class="date-pill">
                  <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
                </span>
              </div>

              <h1 class="article-title">{title}</h1>

              {description && <p class="article-subtitle">{description}</p>}

              <!-- Quick Meta & Share Strip -->
              <div class="article-meta-strip">
                <div class="author-inline">
                  <div class="author-avatar-sm">
                    {author?.avatar ? (
                      <img src={author.avatar} alt={author.name} />
                    ) : (
                      <span>{author?.name ? author.name.charAt(0) : 'E'}</span>
                    )}
                  </div>
                  <div>
                    <span class="byline">Written by</span>
                    <span class="author-name-text">{author?.name ?? 'Editorial Team'}</span>
                  </div>
                </div>

                <div class="quick-share">
                  <span class="share-text">Share:</span>
                  <button class="share-btn copy-btn" id="copyLinkBtn" title="Copy link" aria-label="Copy Link">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span class="tooltip" id="copyTooltip">Link Copied!</span>
                  </button>
                  <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74V10.13H5.06v8.37h2.8z"/></svg>
                  </a>
                </div>
              </div>
            </header>

            <!-- Featured Image -->
            {image && (
              <figure class="featured-media-container">
                <img src={image} alt={imageAlt ?? title} width="960" height="480" loading="eager" />
                {imageAlt && <figcaption>{imageAlt}</figcaption>}
              </figure>
            )}

            <!-- Post Markdown Body -->
            <div class="article-body">
              <slot />
            </div>

            <!-- Tags Section -->
            {tags && tags.length > 0 && (
              <div class="tags-container">
                <span class="tags-label">Related Topics:</span>
                <div class="tags-list">
                  {tags.map((tag: string) => (
                    <a href={`/sam/blog?tag=${encodeURIComponent(tag)}`} class="tag-pill">
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Bottom Engagement Share Card -->
            <div class="share-box">
              <div class="share-box-content">
                <h4>Found this valuable?</h4>
                <p>Share this post with your network and help others build better.</p>
              </div>
              <div class="share-box-actions">
                <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="btn-green-share" target="_blank" rel="noopener noreferrer">
                  Share on X
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="btn-outline-share" target="_blank" rel="noopener noreferrer">
                  Share on LinkedIn
                </a>
              </div>
            </div>
          </article>

          <!-- Related Posts Section -->
          {relatedPosts.length > 0 && (
            <section class="related-posts" aria-label="Related posts">
              <div class="section-header">
                <h2>Recommended Articles</h2>
                <a href={`/sam/blog?category=${encodeURIComponent(category)}`} class="view-all-link">
                  See all {category} &rarr;
                </a>
              </div>
              <div class="post-grid">
                {relatedPosts.map((related) => (
                  <article class="modern-card">
                    {related.data.image && (
                      <a href={`/sam/blog/${related.slug}`} class="card-thumb" tabindex="-1">
                        <img src={related.data.image} alt={related.data.title} loading="lazy" width="300" height="160" />
                      </a>
                    )}
                    <div class="card-body">
                      <span class="card-category">{related.data.category}</span>
                      <h3 class="card-title">
                        <a href={`/sam/blog/${related.slug}`}>{related.data.title}</a>
                      </h3>
                      <span class="card-date">{dateFormatter.format(related.data.pubDate)}</span>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </main>

        <!-- Sticky Sidebar with Author Bio -->
        <aside class="sidebar-col" aria-label="Sidebar">
          <div class="sticky-sidebar">
            
            <!-- AUTHOR BIO & PROFILE CARD -->
            <div class="sidebar-widget author-card-widget">
              <div class="widget-badge">Author Profile</div>
              <div class="author-card-header">
                <div class="author-avatar-lg">
                  {author?.avatar ? (
                    <img src={author.avatar} alt={author.name} />
                  ) : (
                    <span>{author?.name ? author.name.charAt(0) : 'S'}</span>
                  )}
                </div>
                <div class="author-info">
                  <h3 class="author-title-name">
                    {author?.name ?? 'Samrat'}
                  </h3>
                  <span class="founder-badge">Founder & Lead Architect</span>
                </div>
              </div>

              <p class="author-bio-text">
                {author?.bio ?? 'Building high-performance web experiences, sharing actionable engineering playbooks and growth insights.'}
              </p>

              <div class="author-social-links">
                {author?.twitter && (
                  <a href={author.twitter} target="_blank" rel="noopener noreferrer" class="social-icon" title="Twitter / X">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                )}
                {author?.linkedin && (
                  <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74V10.13H5.06v8.37h2.8z"/></svg>
                  </a>
                )}
                {author?.github && (
                  <a href={author.github} target="_blank" rel="noopener noreferrer" class="social-icon" title="GitHub">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Categories Card -->
            <div class="sidebar-widget">
              <h4 class="widget-title">Explore Topics</h4>
              <ul class="clean-category-list">
                <li><a href="/sam/blog?category=Technology"><span>Technology</span> <span class="arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Work+%26+Life"><span>Work &amp; Life</span> <span class="arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Design"><span>Design &amp; UI</span> <span class="arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Growth"><span>Growth &amp; SEO</span> <span class="arrow">&rarr;</span></a></li>
              </ul>
            </div>

            <!-- Newsletter Pill -->
            <div class="sidebar-widget newsletter-widget">
              <div class="widget-header">
                <span class="pulse-dot"></span>
                <h4 class="widget-title">Weekly Insights</h4>
              </div>
              <p>Actionable guides on web engineering & design delivered to your inbox.</p>
              <form class="mini-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
                <input type="email" placeholder="Enter your email" required />
                <button type="submit">Subscribe</button>
              </form>
            </div>

          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Top Reading Progress
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.article-body');
    if (progressBar && article) {
      const totalHeight = article.clientHeight;
      const articleOffsetTop = article.getBoundingClientRect().top + window.scrollY;
      const currentScroll = window.scrollY - articleOffsetTop;

      if (currentScroll > 0) {
        const progress = Math.min(100, Math.max(0, (currentScroll / (totalHeight - window.innerHeight + 100)) * 100));
        progressBar.style.width = `${progress}%`;
      } else {
        progressBar.style.width = '0%';
      }
    }
  });

  // Copy Link Handler
  const copyBtn = document.getElementById('copyLinkBtn');
  const tooltip = document.getElementById('copyTooltip');
  if (copyBtn && tooltip) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        tooltip.classList.add('visible');
        setTimeout(() => tooltip.classList.remove('visible'), 2000);
      } catch (err) {
        console.error('Copy failed', err);
      }
    });
  }
</script>

<style>
  /* ==========================================================
     GREENISH THEME VARIABLES (Emerald / Mint Focus)
  ========================================================== */
  :root {
    --green-600: #059669;
    --green-700: #047857;
    --green-800: #065f46;
    --green-50: #f0fdf4;
    --green-100: #dcfce7;
    --green-200: #bbf7d0;
    
    --text-main: #0f172a;
    --text-body: #334155;
    --text-muted: #64748b;
    --border-light: #e2e8f0;
    --bg-card: #ffffff;
    --bg-page: #fafbfc;
  }

  /* Progress Bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, #10b981, var(--green-600), var(--green-800));
    width: 0%;
    z-index: 9999;
    transition: width 0.08s ease-out;
  }

  /* Container & Spacing Reductions */
  .blog-wrapper {
    background-color: var(--bg-page);
    color: var(--text-body);
    padding: 0.75rem 0 2rem; /* Reduced extra top/bottom space */
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .breadcrumb-container {
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  /* Grid Layout: Main Article + Sticky Sidebar */
  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 2rem;
    align-items: start; /* Essential for CSS sticky sidebar */
  }

  .content-col {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  /* ==========================================================
     ARTICLE HEADER & TITLE (Optimized Typography)
  ========================================================== */
  .article-header {
    margin-bottom: 1.25rem;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .category-badge {
    background: var(--green-50);
    color: var(--green-700);
    border: 1px solid var(--green-200);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .read-time-pill,
  .date-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-title {
    font-size: clamp(1.65rem, 2.7vw, 2.25rem); /* Balanced headline size */
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-main);
    margin: 0.2rem 0 0.5rem 0;
  }

  .article-subtitle {
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
  }

  /* Author Strip + Quick Share */
  .article-meta-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .author-inline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .author-avatar-sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--green-50);
    border: 1px solid var(--green-200);
    color: var(--green-700);
    font-weight: 700;
    display: grid;
    place-items: center;
    overflow: hidden;
    font-size: 0.85rem;
  }

  .author-avatar-sm img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .byline {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: block;
    line-height: 1.1;
  }

  .author-name-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .quick-share {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .share-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-right: 0.2rem;
  }

  .share-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid var(--border-light);
    color: var(--text-muted);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    transition: all 0.15s ease;
  }

  .share-btn:hover {
    background: var(--green-600);
    color: #ffffff;
    border-color: var(--green-600);
  }

  .tooltip {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: #0f172a;
    color: #fff;
    font-size: 0.68rem;
    padding: 2px 6px;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    white-space: nowrap;
    z-index: 10;
  }

  .tooltip.visible {
    opacity: 1;
  }

  /* Featured Image */
  .featured-media-container {
    margin: 0 0 1.5rem 0;
  }

  .featured-media-container img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    border: 1px solid var(--border-light);
  }

  .featured-media-container figcaption {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.4rem;
    font-style: italic;
  }

  /* ==========================================================
     ENGAGING MARKDOWN BODY STYLING
  ========================================================== */
  :global(.article-body) {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-body);
  }

  :global(.article-body p) {
    margin-bottom: 1.15rem;
  }

  :global(.article-body h2) {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.3;
    margin: 1.75rem 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--green-50);
    letter-spacing: -0.015em;
  }

  :global(.article-body h3) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.35;
    margin: 1.35rem 0 0.5rem;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 0.85rem 0 1.15rem 1.2rem;
    padding-left: 0.5rem;
  }

  :global(.article-body li) {
    margin-bottom: 0.4rem;
  }

  :global(.article-body li::marker) {
    color: var(--green-600);
    font-weight: 700;
  }

  :global(.article-body blockquote) {
    margin: 1.35rem 0;
    padding: 0.9rem 1.2rem;
    background: var(--green-50);
    border-left: 4px solid var(--green-600);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: var(--green-800);
    font-size: 1.02rem;
  }

  :global(.article-body blockquote p) {
    margin: 0;
  }

  /* Custom Green Callout Boxes inside Markdown */
  :global(.article-body .callout) {
    background: var(--green-50);
    border: 1px solid var(--green-200);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
  }

  :global(.article-body .callout strong) {
    color: var(--green-800);
  }

  :global(.article-body a) {
    color: var(--green-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }

  :global(.article-body a:hover) {
    color: var(--green-700);
  }

  :global(.article-body code:not(pre code)) {
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.88em;
    border: 1px solid #e2e8f0;
  }

  :global(.article-body pre) {
    background: #0f172a;
    color: #f8fafc;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.88rem;
  }

  :global(.article-body table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.35rem 0;
    font-size: 0.9rem;
  }

  :global(.article-body th),
  :global(.article-body td) {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border-light);
    text-align: left;
  }

  :global(.article-body th) {
    background: var(--green-50);
    color: var(--green-800);
    font-weight: 700;
  }

  /* Tags */
  .tags-container {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .tags-label {
