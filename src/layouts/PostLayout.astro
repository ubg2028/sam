// src/layouts/PostLayout.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { getAuthorBySlug } from '../data/authors';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, authorSlug, category, tags, image, imageAlt } = post.data;
const author = getAuthorBySlug(authorSlug);

// Reading time calculation
const wordsPerMinute = 200;
const wordCount = post.body ? post.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / wordsPerMinute));

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Related Posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  currentPath={`/sam/blog/${post.slug}`}
  type="article"
  publishedTime={pubDate}
  author={author?.name}
  image={image}
>
  <slot name="head" slot="head" />

  <!-- Smooth Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <div class="blog-wrapper">
    <div class="container">
      
      <!-- Compact Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <Breadcrumb items={[{ label: 'Blog', href: '/sam/blog' }, { label: category, href: `/sam/blog?category=${encodeURIComponent(category)}` }, { label: title }]} />
      </nav>

      <!-- Main Layout Grid (Content + Sticky Sidebar) -->
      <div class="page-layout">
        
        <!-- Main Article Content Column -->
        <main class="content-col">
          <article class="article-wrapper">
            
            <!-- Article Header -->
            <header class="article-header">
              <div class="header-pills">
                <a href={`/sam/blog?category=${encodeURIComponent(category)}`} class="category-badge">
                  {category}
                </a>
                <span class="read-time-pill">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {readingTime} min read
                </span>
              </div>

              <!-- Main Post Title -->
              <h1 class="article-title">{title}</h1>

              {description && <p class="article-subtitle">{description}</p>}

              <!-- Author & Date Meta Card -->
              <div class="article-meta-card">
                <div class="author-meta-info">
                  <div class="author-avatar-placeholder">
                    {author?.name ? author.name.charAt(0) : 'E'}
                  </div>
                  <div class="meta-details">
                    <span class="author-name">
                      {author ? <a href={`/sam/team/${author.slug}`}>{author.name}</a> : 'Editorial Team'}
                    </span>
                    <div class="date-info">
                      <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
                      {updatedDate && (
                        <>
                          <span class="dot">&bull;</span>
                          <span class="updated-text">Updated {dateFormatter.format(updatedDate)}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Fast Social Sharing Controls -->
                <div class="quick-share">
                  <button class="share-btn copy-btn" id="copyLinkBtn" title="Copy article link" aria-label="Copy Link">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span class="tooltip" id="copyTooltip">Link Copied!</span>
                  </button>
                  <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="share-btn" aria-label="Share on X" target="_blank" rel="noopener noreferrer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="share-btn" aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74V10.13H5.06v8.37h2.8z"/></svg>
                  </a>
                </div>
              </div>
            </header>

            <!-- Featured Hero Image -->
            {image && (
              <figure class="featured-media-box">
                <img src={image} alt={imageAlt ?? title} width="960" height="500" loading="eager" decoding="async" />
                {imageAlt && <figcaption>{imageAlt}</figcaption>}
              </figure>
            )}

            <!-- Post Content Slot with Modern Styling -->
            <div class="article-body">
              <slot />
            </div>

            <!-- Tags Section -->
            {tags && tags.length > 0 && (
              <div class="tags-container">
                <span class="tags-label">Related Topics:</span>
                <div class="tags-list">
                  {tags.map((tag: string) => (
                    <a href={`/sam/blog?tag=${encodeURIComponent(tag)}`} class="tag-pill">
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Engagement & Share Box (Emerald Glow) -->
            <div class="share-box">
              <div class="share-box-content">
                <h4>Found this guide valuable?</h4>
                <p>Share it with your teammates and network to help them scale faster.</p>
              </div>
              <div class="share-box-actions">
                <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} class="share-pill share-green" target="_blank" rel="noopener noreferrer">
                  Share on X
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} class="share-pill share-outline" target="_blank" rel="noopener noreferrer">
                  Share on LinkedIn
                </a>
              </div>
            </div>

            <!-- Author Card -->
            {author && (
              <div class="author-section">
                <AuthorBio authorSlug={author.slug} />
              </div>
            )}
          </article>

          <!-- Recommended Posts -->
          {relatedPosts.length > 0 && (
            <section class="related-posts" aria-label="Related posts">
              <div class="section-header">
                <h2>Recommended Articles</h2>
                <a href={`/sam/blog?category=${encodeURIComponent(category)}`} class="view-all-link">
                  More in {category} &rarr;
                </a>
              </div>
              <div class="post-grid">
                {relatedPosts.map((related) => (
                  <article class="modern-card">
                    {related.data.image && (
                      <a href={`/sam/blog/${related.slug}`} class="card-thumb" tabindex="-1">
                        <img src={related.data.image} alt={related.data.title} loading="lazy" width="340" height="180" />
                      </a>
                    )}
                    <div class="card-body">
                      <span class="card-category">{related.data.category}</span>
                      <h3 class="card-title">
                        <a href={`/sam/blog/${related.slug}`}>{related.data.title}</a>
                      </h3>
                      <span class="card-date">{dateFormatter.format(related.data.pubDate)}</span>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </main>

        <!-- True Sticky Sidebar -->
        <aside class="sidebar-col" aria-label="Article Sidebar">
          <div class="sticky-sidebar">
            
            <!-- Table of Contents Widget (Auto-populated by JS) -->
            <div class="sidebar-widget toc-widget" id="toc-container" style="display: none;">
              <h3 class="widget-title">
                <span class="widget-title-icon">📖</span> On this page
              </h3>
              <nav id="toc-list" class="toc-list"></nav>
            </div>

            <!-- Newsletter Signup Widget -->
            <div class="sidebar-widget newsletter-widget">
              <div class="widget-header">
                <span class="widget-badge">Free Insights</span>
                <h3>Level up your engineering & growth</h3>
              </div>
              <p>Get our top curated tactics, frameworks, and guides delivered directly to your inbox weekly.</p>
              <form class="mini-form" onsubmit="event.preventDefault(); alert('Thanks for subscribing!');">
                <input type="email" placeholder="Enter your email" required aria-label="Email address" />
                <button type="submit">Subscribe Now</button>
              </form>
            </div>

            <!-- Categories Widget -->
            <div class="sidebar-widget">
              <h3 class="widget-title">
                <span class="widget-title-icon">📂</span> Explore Categories
              </h3>
              <ul class="clean-category-list">
                <li><a href="/sam/blog?category=Technology"><span>Technology</span> <span class="badge-arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Work+%26+Life"><span>Work &amp; Life</span> <span class="badge-arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Design"><span>Product &amp; Design</span> <span class="badge-arrow">&rarr;</span></a></li>
                <li><a href="/sam/blog?category=Growth"><span>Growth &amp; SEO</span> <span class="badge-arrow">&rarr;</span></a></li>
              </ul>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // 1. Reading Progress Bar Handler
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.article-body');
    if (progressBar && article) {
      const totalHeight = article.clientHeight;
      const windowHeight = window.innerHeight;
      const articleOffsetTop = article.getBoundingClientRect().top + window.scrollY;
      const currentScroll = window.scrollY - articleOffsetTop;

      if (currentScroll > 0) {
        const progress = Math.min(100, Math.max(0, (currentScroll / (totalHeight - windowHeight + 100)) * 100));
        progressBar.style.width = `${progress}%`;
      } else {
        progressBar.style.width = '0%';
      }
    }
  });

  // 2. Quick Copy URL Handler
  const copyBtn = document.getElementById('copyLinkBtn');
  const tooltip = document.getElementById('copyTooltip');
  if (copyBtn && tooltip) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        tooltip.classList.add('visible');
        setTimeout(() => tooltip.classList.remove('visible'), 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }

  // 3. Dynamic Table of Contents (TOC) Generator
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.article-body h2, .article-body h3');
    const tocContainer = document.getElementById('toc-container');
    const tocList = document.getElementById('toc-list');

    if (headings.length > 1 && tocContainer && tocList) {
      tocContainer.style.display = 'block';
      
      headings.forEach((heading, index) => {
        let id = heading.id;
        if (!id) {
          id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `heading-${index}`;
          heading.id = id;
        }

        const link = document.createElement('a');
        link.href = `#${id}`;
        link.textContent = heading.textContent;
        link.className = heading.tagName === 'H3' ? 'toc-link toc-h3' : 'toc-link toc-h2';
        
        tocList.appendChild(link);
      });
    }
  });
</script>

<style>
  /* ==========================================================
     GREENISH MODERN COLOR PALETTE & DESIGN SYSTEM
  ========================================================== */
  :root {
    --green-primary: #059669;        /* Deep Emerald */
    --green-primary-hover: #047857;  /* Emerald 700 */
    --green-accent: #10b981;         /* Vibrant Emerald */
    --green-light: #f0fdf4;          /* Soft Mint Wash */
    --green-light-border: #bbf7d0;   /* Mint Border */
    --green-dark: #064e3b;           /* Emerald 900 */
    --text-heading: #0f172a;         /* Deep Slate */
    --text-body: #334155;            /* Slate 700 */
    --text-muted: #64748b;           /* Slate 500 */
    --bg-surface: #ffffff;
    --bg-subtle: #f8fafc;
    --border-color: #e2e8f0;
    --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  /* Reading Progress Bar */
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3.5px;
    background: linear-gradient(90deg, #34d399, #059669, #047857);
    width: 0%;
    z-index: 9999;
    transition: width 0.05s ease-out;
  }

  .blog-wrapper {
    background-color: var(--bg-surface);
    color: var(--text-body);
    padding: 0.75rem 0 2.5rem;
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .breadcrumb-nav {
    margin-bottom: 0.85rem;
    font-size: 0.82rem;
  }

  /* Grid Layout: Main Article + Sticky Sidebar */
  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2.25rem;
    align-items: start;
  }

  /* ==========================================================
     RELIABLE STICKY SIDEBAR
  ========================================================== */
  .sidebar-col {
    position: relative;
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--green-light-border) transparent;
  }

  .sidebar-widget {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.1rem;
    box-shadow: var(--card-shadow);
  }

  .widget-title {
    margin: 0 0 0.75rem 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-heading);
    display: flex;
    align-items: center;
    gap: 0.4rem;
