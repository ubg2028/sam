---
// src/components/AuthorBio.astro
// E-E-A-T author box, rendered at the end of every post. Pulls from the
// shared authors data file and links to that author's full profile page.
import { getAuthorBySlug } from '../data/authors';

export interface Props {
  authorSlug: string;
}

const { authorSlug } = Astro.props;
const author = getAuthorBySlug(authorSlug);
---
{author && (
  <div class="author-bio">
    <div class="author-avatar" aria-hidden="true">{author.avatarInitials}</div>
    <div>
      <h3><a href={`/sam/team/${author.slug}`}>{author.name}</a></h3>
      <p>{author.bio}</p>
      <p class="author-links"><a href={`/sam/team/${author.slug}`}>More from {author.name.split(' ')[0]} &rarr;</a></p>
    </div>
  </div>
)}
