---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getAuthorBySlug } from '../data/authors';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [heroPost, ...restPosts] = allPosts;
const gridPosts = restPosts.slice(0, 6);
const recentPosts = allPosts.slice(0, 3);
const categories = [...new Set(allPosts.map((p) => p.data.category))];

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const heroAuthor = heroPost ? getAuthorBySlug(heroPost.data.authorSlug) : undefined;
---
<BaseLayout
  title="Verdant Notes — Ideas Worth Your Time"
  description="Verdant Notes publishes clear, well-researched essays on technology, work, and sustainable living — written by people who have actually done the thing."
  currentPath="../sam"
>
  {heroPost && (
    <section class="hero" aria-label="Featured article">
      <div class="container">
        <div>
          <p class="hero-eyebrow">Featured &middot; {heroPost.data.category}</p>
          <h1 class="hero-title"><a href={`/sam/sam/blog/${heroPost.slug}`}>{heroPost.data.title}</a></h1>
          <p class="hero-excerpt">{heroPost.data.description}</p>
          <p class="hero-meta">
            {heroAuthor && <>By <a href={`/sam/sam/team/${heroAuthor.slug}`}>{heroAuthor.name}</a> &middot; </>}
            {dateFormatter.format(heroPost.data.pubDate)}
          </p>
        </div>
        <div class="hero-media">
          {heroPost.data.image ? <img src={heroPost.data.image} alt={heroPost.data.imageAlt ?? ''} width="600" height="375" /> : null}
        </div>
      </div>
    </section>
  )}

  <div class="container">
    <AdSlot position="leaderboard" />
  </div>

  <div class="container">
    <div class="page-layout">
      <div class="content-col">
        <div class="section-heading" id="latest-posts">
          <h2>Latest Posts</h2>
          <a href="/sam/blog">View all</a>
        </div>

        {gridPosts.length > 0 ? (
          <div class="post-grid">
            {gridPosts.map((post) => (
              <article class="post-card">
                <a href={`/sam/sam/blog/${post.slug}`} class="post-card-media" aria-hidden="true">
                  {post.data.image ? <img src={post.data.image} alt="" loading="lazy" width="400" height="250" /> : null}
                </a>
                <span class="post-card-category">{post.data.category}</span>
                <h3><a href={`/sam/sam/blog/${post.slug}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <p class="post-card-meta">{getAuthorBySlug(post.data.authorSlug)?.name} &middot; {dateFormatter.format(post.data.pubDate)}</p>
              </article>
            ))}
          </div>
        ) : (
          <p style="color:var(--color-text-secondary);">More posts are on the way — check back soon.</p>
        )}
      </div>

      <aside class="sidebar" aria-label="Sidebar">
        <div class="widget">
          <h3>Categories</h3>
          <ul class="category-list">
            {categories.map((cat) => <li><a href="/sam/blog">{cat}</a></li>)}
          </ul>
        </div>

        <div class="widget">
          <h3>Recent Posts</h3>
          <ul>
            {recentPosts.map((post) => (
              <li class="recent-post-item">
                <span class="recent-post-thumb" aria-hidden="true">
                  {post.data.image ? <img src={post.data.image} alt="" loading="lazy" width="56" height="56" /> : null}
                </span>
                <div>
                  <h4><a href={`/sam/sam/blog/${post.slug}`}>{post.data.title}</a></h4>
                  <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <AdSlot position="sidebar" />

        <div class="widget">
          <h3>About Verdant Notes</h3>
          <p style="font-size:0.92rem;color:var(--color-text-secondary);">A small team of working writers and engineers who publish what they've actually tested.</p>
          <p style="margin-top:0.8em;"><a href="/sam/about">Read our story &rarr;</a></p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
